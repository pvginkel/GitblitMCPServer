.claude
.kubecoder
.vscode
.gitignore
.dockerignore
.env
.env.*
docs
tests
scripts
Jenkinsfile
Jenkinsfile.architecture
*.code-workspace
README.md
AGENTS.md
CLAUDE.md
LICENSE
__pycache__
**/__pycache__
*.pyc
.coverage
/tmp
