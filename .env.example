# Gitblit MCP Server Configuration

# Base URL of your Gitblit instance with the Search API Plugin installed
# Examples:
#   GITBLIT_URL=http://localhost:8080
#   GITBLIT_URL=https://gitblit.example.com
GITBLIT_URL=http://10.1.2.3

# MCP Server Settings
# Port for the MCP server HTTP endpoint (default: 8000)
MCP_PORT=8000

# Host to bind the MCP server to (default: 0.0.0.0)
# Use 127.0.0.1 to only allow local connections
MCP_HOST=0.0.0.0

# Transport to expose (default: sse)
#   sse  - legacy SSE, at /sse and /messages/
#   http - streamable HTTP, at /mcp, stateless (survives server restarts)
# MCP_TRANSPORT=http

# MCP endpoint path prefix (default: empty)
# Use this when hosting behind a reverse proxy at a sub-path
# Default paths are /sse and /messages/ (sse) or /mcp (http)
# Setting MCP_PATH_PREFIX=/api/mcp results in /api/mcp/sse and /api/mcp/messages/,
# or /api/mcp/mcp
# MCP_PATH_PREFIX=/api/mcp

# Repository cache TTL in seconds (default: 600 = 10 minutes)
# Used for validating repository names and suggesting alternatives on errors
# REPO_CACHE_TTL=600

# Instructions returned in the MCP initialize response (initialize.instructions)
# Guidance shown to MCP clients on how to use this server.
# Omit or leave empty to keep the server's built-in default.
# MCP_INSTRUCTIONS=Use the gb_* tools to browse and search Gitblit repositories.
